# Contact form (app/api/contact/route.ts). Copy to .env.local and fill in.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives messages (defaults to site.email in data/content.ts)
CONTACT_TO=masoodpk555@gmail.com
# Sender. onboarding@resend.dev works with no domain setup, but only delivers
# to the email you signed up to Resend with. Verify a domain to change it.
CONTACT_FROM=Portfolio <onboarding@resend.dev>
